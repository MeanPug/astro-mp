# WordPress the build reads content from (server side). Inside Docker: http://wordpress
# Production: the WP Engine install URL, e.g. https://astromp.wpengine.com
WP_API_URL=http://localhost:8000
# WordPress the browser submits Gravity Forms to
PUBLIC_WP_URL=http://localhost:8000
# Public URL of this front-end (canonical, og:url). On Netlify it falls back to the deploy URL when unset.
SITE_URL=http://localhost:4321
# Analytics (optional). The PHP theme hardcodes GTM-WBWXWX24 and Clarity y8k5meits7
PUBLIC_GTM_ID=
PUBLIC_CLARITY_ID=
