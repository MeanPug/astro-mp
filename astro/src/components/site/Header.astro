---
/**
 * Landing-page header: logo on the left, "Call us 24/7 / Free Case Evaluation" and the phone
 * number on the right. Phone comes from Theme Settings > contact_phone; the two captions are
 * the landing copy from the Figma file.
 */
import type { WpGlobals } from '../../lib/wp/types';
import WpImage from '../ui/WpImage.astro';

interface Props {
    globals: WpGlobals;
    currentPath: string;
}

const { globals } = Astro.props;
const { options, logo, site } = globals;
const contactPhone = options.contact_phone || null;
---

<header class="mp-header">
    <div class="mp-header__inner">
        <a href="/" class="mp-header__logo" rel="home" aria-label={site.name}>
            {logo ? (
                <WpImage image={logo} size="full" class="w-full h-auto" alt={logo.alt || site.name} loading="eager" fetchpriority="high" sizes="(min-width: 1024px) 336px, 224px" />
            ) : (
                <span class="font-heading font-bold text-2xl text-ink">{site.name}</span>
            )}
        </a>

        {contactPhone && (
            <div class="mp-header__contact">
                <span class="mp-header__contact-label">Call us 24/7</span>
                <span class="mp-header__contact-label">Free Case Evaluation</span>
                <a href={contactPhone.url} class="mp-header__phone">{contactPhone.title}</a>
            </div>
        )}
    </div>
</header>
