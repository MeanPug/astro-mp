---
/**
 * Scroll-snap carousel with prev/next arrows and dots (scripts/carousel.ts). Slides are
 * passed as <li class="mp-carousel__slide"> children; without JS it is a horizontal scroller.
 */
interface Props {
    label: string;
    class?: string;
}

const { label, class: className } = Astro.props;
---

<div class:list={['mp-carousel', className]} data-carousel>
    <!-- arrows live inside the track wrapper so they centre on the slides, not on slides + dots -->
    <div class="mp-carousel__track">
        <button type="button" class="mp-carousel__arrow mp-carousel__arrow--prev" data-carousel-prev aria-label={`Previous ${label.toLowerCase()}`}>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>

        <ul class="mp-carousel__viewport" data-carousel-viewport aria-label={label}>
            <slot />
        </ul>

        <button type="button" class="mp-carousel__arrow mp-carousel__arrow--next" data-carousel-next aria-label={`Next ${label.toLowerCase()}`}>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
    </div>

    <div class="mp-carousel__dots" data-carousel-dots role="tablist" aria-label={`${label} pages`}></div>
</div>
