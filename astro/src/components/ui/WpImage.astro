---
/**
 * Renders an image object from the astro/v1 API the way wp_get_attachment_image() does:
 * src of the requested size, srcset of all generated sizes, intrinsic dimensions.
 * Media stays hosted by WordPress.
 */
import type { AcfImage } from '../../lib/wp/acf';

type Size = keyof AcfImage['sizes'];

interface Props {
    image: AcfImage | null | undefined;
    size?: Size;
    class?: string;
    alt?: string;
    sizes?: string;
    loading?: 'lazy' | 'eager';
    fetchpriority?: 'high' | 'low' | 'auto';
    decoding?: 'async' | 'sync' | 'auto';
    [attr: string]: unknown;
}

const { image, size = 'large', class: className, alt, sizes, loading = 'lazy', fetchpriority, decoding = 'async', ...rest } = Astro.props;

const picked = image ? image.sizes?.[size] ?? image.sizes?.full ?? { url: image.url, width: image.width, height: image.height } : null;
const isSvg = image?.mime === 'image/svg+xml';
---

{image && picked && (
    <img
        src={picked.url}
        srcset={!isSvg && image.srcset ? image.srcset : undefined}
        sizes={!isSvg && image.srcset ? sizes ?? '(min-width: 1200px) 1200px, 100vw' : undefined}
        width={picked.width || undefined}
        height={picked.height || undefined}
        alt={alt ?? image.alt ?? ''}
        class={className}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={decoding}
        {...rest}
    />
)}
